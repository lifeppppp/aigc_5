[Unit]
Description=GroupIntel relay (DingTalk + Aliyun Bailian)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/groupintel/server
EnvironmentFile=/opt/groupintel/.env
ExecStart=/usr/bin/python3 -m uvicorn app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
