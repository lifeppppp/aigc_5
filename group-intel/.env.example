# 复制成服务器上的 /opt/groupintel/.env，不要提交到 git
# 阿里百炼（在百炼控制台 → API-KEY 获取，sk- 开头）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 老接口域名对所有账号都能用；若百炼控制台给了业务空间专属域名，替换整行
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus

# 客户端访问令牌：客户端「设置」里要填同一个值，防止公网被人白嫖算力
CLIENT_TOKEN=改成一串随机字符

# 钉钉群自定义机器人（群设置 → 智能群助手 → 添加自定义机器人）
DINGTALK_ROBOT_WEBHOOK=
DINGTALK_ROBOT_SECRET=

# 钉钉 Stream 模式机器人（open-dev.dingtalk.com → 企业内部应用）
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
